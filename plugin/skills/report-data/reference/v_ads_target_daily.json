{
 "_meta": {
  "table": "v_ads_target_daily",
  "report_type": null,
  "is_snapshot": false,
  "description": "Amazon Ads per target (keyword, targeting clause, SB theme) per day, with its keyword text, match type, expression, bid and state, and the campaign / ad group names.",
  "search_aliases": [
   "keyword report",
   "target report",
   "keyword performance",
   "bid review"
  ],
  "caveats": [
   "The daily Stream facts summed at this grain; names and states are the entity's CURRENT ones (rpt_ads_* entity tables), never a stale copy.",
   "Conversions mature over attribution_window_days and Amazon restates them for 70 days.",
   "Ratios (ACOS, ROAS, CTR, CVR) are not stored: compute them from the sums.",
   "Never add a Stream number to a v3 (rpt_sp_* / rpt_sb_* / rpt_sd_*) number."
  ],
  "pii": false,
  "queryable": true,
  "deprecated": false,
  "strategy": "view",
  "date_column": "report_date",
  "unique_key": null,
  "cron": null,
  "source_tables": [
   "rpt_ads_performance_daily",
   "rpt_ads_targets",
   "rpt_ads_campaigns",
   "rpt_ads_ad_groups"
  ],
  "marketplace": {
   "grain": "per_mkt",
   "label": {
    "kind": "requested",
    "column": "country_code",
    "values": null,
    "means": "marketplace",
    "nullable": false,
    "null_means": "unplaced"
   }
  }
 },

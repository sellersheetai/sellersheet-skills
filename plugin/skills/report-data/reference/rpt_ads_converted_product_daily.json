 "_meta": {
  "table": "rpt_ads_converted_product_daily",
  "report_type": "ads-converted-product-v1",
  "is_snapshot": false,
  "description": "Amazon Ads conversions by the product that converted (Marketing Stream ads-converted-product-v1): one row per marketplace-local day per advertised product per converted product, split by product_relevance into products the ad promoted and halo products it did not. Kept 400 days.",
  "search_aliases": [
   "converted product",
   "purchased product",
   "halo sales",
   "brand halo",
   "ads converted asin"
  ],
  "caveats": [
   "Carries no target id or search term: compare it per campaign / ad group / ASIN.",
   "A tombstone (is_tombstone) is a record Amazon deleted: every metric is NULL.",
   "Conversions mature over attribution_window_days and Amazon restates them for 70 days.",
   "Never add a Stream number to a v3 (rpt_*_purchased_products) number.",
   "Uncalibrated: no delivery of this dataset has been read yet.",
   "History still loading: a new subscription delivers the dataset's last 70 days over its first 48 hours, so earlier days may be missing until then (Admin → Health lists the accounts)."
  ],
  "pii": false,
  "queryable": true,
  "deprecated": false,
  "strategy": "stream",
  "date_column": "report_date",
  "unique_key": [
   "store_id",
   "country_code",
   "report_date",
   "record_key"
  ],
  "cron": null,
  "retention_days": 400,
  "retention_note": "kept 400 days by report_date; older rows are pruned",
  "marketplace": {
   "grain": "per_mkt",
   "label": {
    "kind": "requested",
    "column": "country_code",
    "values": null,
    "means": "marketplace",
    "nullable": false,
    "null_means": "unplaced"
   }
  }
 },
